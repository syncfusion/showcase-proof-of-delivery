{
  "name": "proof-of-delivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdfviewer-resources.mjs",
    "predev": "node scripts/copy-theme.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-theme.mjs",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "start": "node server.mjs",
    "generate-receipts": "node scripts/generate-receipts.mjs"
  },
  "dependencies": {
    "@syncfusion/ej2-pdf": "34.2.8",
    "@syncfusion/ej2-react-buttons": "34.2.8",
    "@syncfusion/ej2-react-navigations": "34.2.8",
    "@syncfusion/ej2-react-notifications": "34.2.8",
    "@syncfusion/ej2-react-pdfviewer": "34.2.8",
    "@syncfusion/ej2-react-popups": "34.2.8",
    "@syncfusion/ej2-tailwind3-theme": "34.2.8",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
